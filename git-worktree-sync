#!/usr/bin/env bash

set -euo pipefail

COMMAND_NAME="git-worktree-sync"
VERSION="1.2.0"

# Configuration
CONFIG_FILE="${GIT_WORKTREE_SYNC_CONFIG:-$HOME/.git-worktree-sync.conf}"
COPY_CONFIG_FILE="${GIT_WORKTREE_SYNC_COPY_CONFIG:-$HOME/.git-worktree-sync-copy.conf}"
DEFAULT_BASE_DIR=""
DEFAULT_COPY_IGNORED=true

# Global arrays for config parsing
declare -a config_includes=()
declare -a config_excludes=()
declare -a config_force_includes=()

# Default exclude patterns for large directories commonly in .gitignore
DEFAULT_EXCLUDE_PATTERNS=(
    # Node.js
    "node_modules/"
    "bower_components/"
    ".npm/"
    ".yarn/"
    ".pnp/"
    ".pnp.js"
    
    # Python
    "__pycache__/"
    "*.py[cod]"
    '*.pyc'
    ".Python"
    "venv/"
    ".venv/"
    "env/"
    "ENV/"
    ".env/"
    "pip-log.txt"
    "pip-delete-this-directory.txt"
    ".tox/"
    ".coverage"
    ".coverage.*"
    ".cache"
    ".pytest_cache/"
    ".mypy_cache/"
    ".dmypy.json"
    "dmypy.json"
    "htmlcov/"
    "dist/"
    "build/"
    "*.egg-info/"
    ".eggs/"
    
    # Ruby
    "vendor/bundle/"
    "vendor/cache/"
    ".bundle/"
    
    # Java
    "target/"
    "*.class"
    ".gradle/"
    "gradle/"
    
    # Go
    "vendor/"
    "bin/"
    
    # Rust
    "target/"
    "Cargo.lock"
    
    # PHP
    "vendor/"
    "composer.phar"
    
    # .NET
    "bin/"
    "obj/"
    "packages/"
    
    # macOS
    ".DS_Store"
    
    # IDEs
    ".idea/"
    "*.iml"
    ".vscode-server/"
    
    # Build outputs
    "dist/"
    "build/"
    "out/"
    "_build/"
    
    # Logs
    "*.log"
    "logs/"
    
    # Temporary files
    "*.tmp"
    "*.temp"
    ".tmp/"
    "tmp/"
    
    # Large data files
    "*.sqlite"
    "*.db"
    "*.sql"
    
    # Docker
    ".docker/"
)

# Load configuration if exists
if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
fi

# Environment variable overrides
BASE_DIR="${GIT_WORKTREE_SYNC_BASE_DIR:-$DEFAULT_BASE_DIR}"

usage() {
    cat << EOF
Usage: $COMMAND_NAME <command> [options]

Commands:
    add <branch>           Create a new worktree with branch name as directory
    add <branch> -p <path> Create a new worktree at specified path
    list                   List all worktrees
    remove <path>          Remove a worktree
    remove <path> -f       Force remove a worktree
    help                   Show this help message

Options:
    -p, --path <path>      Specify custom path for worktree
    -b, --base-dir <dir>   Base directory for worktrees (overrides config)
    -c, --copy-ignored     Copy .gitignore'd files (default: true)
    --no-copy-ignored      Don't copy .gitignore'd files
    --copy-config <file>   Use custom copy configuration file
    -h, --help             Show help

Configuration:
    Config file: ~/.git-worktree-sync.conf
    Copy config file: ~/.git-worktree-sync-copy.conf
    Environment variables:
        GIT_WORKTREE_SYNC_BASE_DIR - Base directory for worktrees
        GIT_WORKTREE_SYNC_CONFIG   - Path to config file
        GIT_WORKTREE_SYNC_COPY_CONFIG - Path to copy config file

Copy Configuration Format:
    # Include patterns (prefix with + or no prefix)
    .env
    .env.local
    +.vscode/
    
    # Exclude patterns (prefix with -)
    -node_modules/
    
    # Force include patterns (prefix with !)
    !node_modules/package.json

Examples:
    $COMMAND_NAME add feature/new-feature
    $COMMAND_NAME add feature/new-feature -p ../my-feature
    $COMMAND_NAME add hotfix/urgent --no-copy-ignored
    $COMMAND_NAME add feature/test --copy-config .worktree-copy.conf
    $COMMAND_NAME list
    $COMMAND_NAME remove ../my-feature

EOF
}

error() {
    echo "Error: $1" >&2
    exit 1
}

info() {
    echo "Info: $1" >&2
}

get_main_worktree() {
    git worktree list --porcelain | grep -E '^worktree ' | head -1 | cut -d' ' -f2-
}

# Check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check if a pattern is in the exclude list
is_excluded() {
    local pattern="$1"
    shift
    local exclude_patterns=("$@")
    
    for exclude in "${exclude_patterns[@]}"; do
        if [[ "$pattern" == "$exclude" ]]; then
            return 0
        fi
    done
    return 1
}

# Parse copy configuration file - sets global arrays
parse_copy_config() {
    local config_file="$1"
    
    if [[ ! -f "$config_file" ]]; then
        return
    fi
    
    # Clear arrays
    config_includes=()
    config_excludes=()
    config_force_includes=()
    
    while IFS= read -r line; do
        # Skip empty lines and comments
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        
        # Remove leading/trailing whitespace
        line=$(echo "$line" | xargs)
        
        if [[ "$line" =~ ^! ]]; then
            # Force include pattern
            local pattern="${line#!}"
            pattern=$(echo "$pattern" | xargs)  # trim whitespace
            config_force_includes+=("$pattern")
        elif [[ "$line" =~ ^- ]]; then
            # Exclude pattern
            config_excludes+=("${line#-}")
        elif [[ "$line" =~ ^\+ ]]; then
            # Explicit include pattern
            config_includes+=("${line#+}")
        else
            # Default to include
            config_includes+=("$line")
        fi
    done < "$config_file"
}

# Optimized copy function using rsync
copy_gitignored_files_rsync() {
    local source_dir="$1"
    local target_dir="$2"
    local copy_config="$3"
    
    info "Using optimized rsync method for copying files"
    
    # Check if rsync is available
    if ! command_exists rsync; then
        info "rsync not found, falling back to standard copy method"
        copy_gitignored_files_standard "$source_dir" "$target_dir" "$copy_config"
        return
    fi
    
    # Create temporary files for rsync
    local include_file=$(mktemp)
    local exclude_file=$(mktemp)
    trap "rm -f $include_file $exclude_file" EXIT
    
    # Initialize arrays
    local include_patterns=()
    local exclude_patterns=()
    local force_include_patterns=()
    
    # Add default excludes
    exclude_patterns+=("${DEFAULT_EXCLUDE_PATTERNS[@]}")
    
    # Parse copy configuration if exists
    if [[ -f "$copy_config" ]]; then
        info "Using copy configuration from: $copy_config"
        parse_copy_config "$copy_config"
        # Copy from global arrays
        [[ ${#config_includes[@]} -gt 0 ]] && include_patterns+=("${config_includes[@]}")
        [[ ${#config_excludes[@]} -gt 0 ]] && exclude_patterns+=("${config_excludes[@]}")
        [[ ${#config_force_includes[@]} -gt 0 ]] && force_include_patterns+=("${config_force_includes[@]}")
    elif [[ -f "$source_dir/.gitignore" ]]; then
        info "Using patterns from .gitignore with default exclusions"
        # Read patterns from .gitignore
        while IFS= read -r pattern; do
            # Skip empty lines and comments
            [[ -z "$pattern" || "$pattern" =~ ^# ]] && continue
            # Remove leading/trailing whitespace
            pattern=$(echo "$pattern" | xargs)
            # Skip negation patterns
            [[ "$pattern" =~ ^! ]] && continue
            
            # Check if pattern is in default excludes
            if ! is_excluded "$pattern" "${exclude_patterns[@]}"; then
                include_patterns+=("$pattern")
            fi
        done < "$source_dir/.gitignore"
    else
        info "No copy configuration or .gitignore found"
        return
    fi
    
    # Write patterns to files
    
    for pattern in "${include_patterns[@]}"; do
        echo "$pattern" >> "$include_file"
    done
    
    if [[ ${#force_include_patterns[@]} -gt 0 ]]; then
        for pattern in "${force_include_patterns[@]}"; do
            echo "$pattern" >> "$include_file"
        done
    fi
    
    for pattern in "${exclude_patterns[@]}"; do
        echo "$pattern" >> "$exclude_file"
    done
    
    # If include file is empty, nothing to copy
    if [[ ! -s "$include_file" ]]; then
        info "No patterns to copy"
        return
    fi
    
    # Always copy .gitignore itself
    if [[ -f "$source_dir/.gitignore" ]]; then
        cp "$source_dir/.gitignore" "$target_dir/" 2>/dev/null || true
    fi
    
    # Use rsync with include/exclude patterns
    info "Copying files matching patterns..."
    # rsync processes options in order - includes first, then excludes
    rsync -av \
        --include-from="$include_file" \
        --include="*/" \
        --exclude=".git/" \
        --exclude-from="$exclude_file" \
        --exclude="*" \
        "$source_dir/" "$target_dir/" || true
}

# Standard copy function (fallback)
copy_gitignored_files_standard() {
    local source_dir="$1"
    local target_dir="$2"
    local copy_config="$3"
    
    info "Using standard copy method"
    
    # Always copy .gitignore itself
    if [[ -f "$source_dir/.gitignore" ]]; then
        cp "$source_dir/.gitignore" "$target_dir/" 2>/dev/null || true
    fi
    
    # Initialize arrays
    local include_patterns=()
    local exclude_patterns=()
    local force_include_patterns=()
    
    # Add default excludes
    exclude_patterns+=("${DEFAULT_EXCLUDE_PATTERNS[@]}")
    
    # Parse copy configuration if exists
    if [[ -f "$copy_config" ]]; then
        info "Using copy configuration from: $copy_config"
        parse_copy_config "$copy_config"
        # Copy from global arrays
        [[ ${#config_includes[@]} -gt 0 ]] && include_patterns+=("${config_includes[@]}")
        [[ ${#config_excludes[@]} -gt 0 ]] && exclude_patterns+=("${config_excludes[@]}")
        [[ ${#config_force_includes[@]} -gt 0 ]] && force_include_patterns+=("${config_force_includes[@]}")
    elif [[ -f "$source_dir/.gitignore" ]]; then
        info "Using patterns from .gitignore with default exclusions"
        while IFS= read -r pattern; do
            # Skip empty lines and comments
            [[ -z "$pattern" || "$pattern" =~ ^# ]] && continue
            # Remove leading/trailing whitespace
            pattern=$(echo "$pattern" | xargs)
            # Skip negation patterns
            [[ "$pattern" =~ ^! ]] && continue
            
            # Check if pattern is in default excludes
            if ! is_excluded "$pattern" "${exclude_patterns[@]}"; then
                include_patterns+=("$pattern")
            fi
        done < "$source_dir/.gitignore"
    else
        info "No copy configuration or .gitignore found"
        return
    fi
    
    # Combine include and force include patterns
    local all_patterns=("${include_patterns[@]}" "${force_include_patterns[@]}")
    
    # Process each pattern
    for pattern in "${all_patterns[@]}"; do
        # Skip if pattern is in exclude list (unless it's a force include)
        if is_excluded "$pattern" "${exclude_patterns[@]}" && ! is_excluded "$pattern" "${force_include_patterns[@]}"; then
            continue
        fi
        
        if [[ "$pattern" =~ /$ ]]; then
            # Directory pattern
            pattern="${pattern%/}"
            if [[ -d "$source_dir/$pattern" ]]; then
                info "Copying directory: $pattern"
                cp -r "$source_dir/$pattern" "$target_dir/" 2>/dev/null || true
            fi
        else
            # File pattern - use find with limited depth for better performance
            while IFS= read -r -d '' file; do
                relative_path="${file#$source_dir/}"
                
                # Check if file matches any exclude pattern
                local skip=false
                for exclude in "${exclude_patterns[@]}"; do
                    if [[ "$relative_path" == $exclude* ]] && ! is_excluded "$pattern" "${force_include_patterns[@]}"; then
                        skip=true
                        break
                    fi
                done
                
                if [[ "$skip" == false ]]; then
                    target_file="$target_dir/$relative_path"
                    target_file_dir=$(dirname "$target_file")
                    
                    # Create directory structure if needed
                    mkdir -p "$target_file_dir"
                    
                    info "Copying: $relative_path"
                    cp "$file" "$target_file" 2>/dev/null || true
                fi
            done < <(find "$source_dir" -maxdepth 5 -path "$source_dir/.git" -prune -o -name "$pattern" -type f -print0)
        fi
    done
}

add_worktree() {
    local branch="$1"
    local path=""
    local copy_ignored=true
    local custom_base_dir=""
    local custom_copy_config=""
    
    # Parse additional arguments
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--path)
                path="$2"
                shift 2
                ;;
            -b|--base-dir)
                custom_base_dir="$2"
                shift 2
                ;;
            -c|--copy-ignored)
                copy_ignored=true
                shift
                ;;
            --no-copy-ignored)
                copy_ignored=false
                shift
                ;;
            --copy-config)
                custom_copy_config="$2"
                shift 2
                ;;
            *)
                error "Unknown option: $1"
                ;;
        esac
    done
    
    # Determine base directory
    local effective_base_dir="${custom_base_dir:-$BASE_DIR}"
    
    # Determine copy config file
    local effective_copy_config="${custom_copy_config:-$COPY_CONFIG_FILE}"
    
    # Look for project-specific copy config
    if [[ -z "$custom_copy_config" && -f ".git-worktree-sync-copy.conf" ]]; then
        effective_copy_config=".git-worktree-sync-copy.conf"
        info "Found project-specific copy configuration"
    fi
    
    # If no path specified, use branch name as directory
    if [[ -z "$path" ]]; then
        # Convert branch name to directory name
        # Replace / with - and remove any special characters
        local dir_name=$(echo "$branch" | sed 's|/|-|g' | sed 's|[^a-zA-Z0-9_-]||g')
        
        # Apply base directory if configured
        if [[ -n "$effective_base_dir" ]]; then
            path="${effective_base_dir}/${dir_name}"
        else
            path="$dir_name"
        fi
        
        # If path already exists, append a number
        if [[ -e "$path" ]]; then
            local i=2
            local base_path="$path"
            while [[ -e "${base_path}-${i}" ]]; do
                ((i++))
            done
            path="${base_path}-${i}"
        fi
    fi
    
    # Create the worktree
    info "Creating worktree at '$path' for branch '$branch'"
    
    # Check if branch exists
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        # Branch exists, create worktree
        git worktree add "$path" "$branch"
    else
        # Branch doesn't exist, create new branch
        git worktree add -b "$branch" "$path"
    fi
    
    # Copy gitignored files if requested
    if [[ "$copy_ignored" == true ]]; then
        local main_worktree=$(get_main_worktree)
        copy_gitignored_files_rsync "$main_worktree" "$path" "$effective_copy_config"
    fi
    
    echo "Successfully created worktree at '$path' for branch '$branch'"
}

list_worktrees() {
    git worktree list
}

remove_worktree() {
    local path="$1"
    local force=false
    
    # Check for force flag
    if [[ "${2:-}" == "-f" || "${2:-}" == "--force" ]]; then
        force=true
    fi
    
    info "Removing worktree at '$path'"
    if [[ "$force" == true ]]; then
        git worktree remove --force "$path"
    else
        git worktree remove "$path"
    fi
    echo "Successfully removed worktree at '$path'"
}

main() {
    # Check if we're in a git repository
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        error "Not in a git repository"
    fi
    
    # Parse command
    case "${1:-}" in
        add)
            if [[ $# -lt 2 ]]; then
                error "Branch name required"
            fi
            add_worktree "${@:2}"
            ;;
        list)
            list_worktrees
            ;;
        remove)
            if [[ $# -lt 2 ]]; then
                error "Path required"
            fi
            remove_worktree "$2" "${3:-}"
            ;;
        help|-h|--help)
            usage
            ;;
        version|-v|--version)
            echo "$COMMAND_NAME version $VERSION"
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

main "$@"